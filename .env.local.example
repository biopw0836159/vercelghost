# 複製成 .env.local 並填值（本機開發用）。
# 同一組變數也要設到 Railway 專案的 Variables。
# 注意：.env.local 不要 commit 進 git（.gitignore 已擋 .env*）。

# ── 後端 open API ──
# 不設則預設 https://stats-crawler.up.railway.app
STATS_BACKEND_URL=
# open API 金鑰，帶在 x-api-key 標頭
APIKEY=

# ── 授權代理（繞過後端 ipGuard）──
# 後端會把未授權來源 302 轉去 booking.com，看起來像「後端掛了」其實是被擋。
# 兩種設法擇一：整串 PROXY，或拆成 HOST/PORT/USER/PASS。
PROXY=
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# ── 自有登入（Supabase Project Settings → API）──
# 注意 SUPABASE_URL 只到專案網域，結尾不要帶 /rest/v1/，否則登入會 500（PGRST125）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # 用 service_role key，不是 anon key
# 自簽 JWT 用的密鑰（隨機長字串，例如 openssl rand -hex 32）
JWT_SECRET=
